          { id: 'rod', name: 'قصبة', toBase: 5.0292 },
          { id: 'league', name: 'فرسخ', toBase: 4828.032 },
          { id: 'parsec', name: 'فرسخ فلكي', toBase: 3.085677581e16 }
        ]
      },
      weight: {
        name: 'الوزن',
