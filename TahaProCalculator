<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>محول الوحدات الشامل | Taha-tech 2026</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --glass-bg: rgba(20, 25, 45, 0.65);
      --glass-border: rgba(255, 255, 255, 0.1);
      --glass-shadow: 0 25px 45px rgba(0, 0, 0, 0.4);
      --accent: #818cf8;
      --accent2: #a78bfa;
      --text: #f1f5f9;
      --text-secondary: #94a3b8;
      --bg-dark: #0b0f1c;
      --input-bg: rgba(15, 23, 42, 0.7);
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-sm: 12px;
      --transition: 0.25s cubic-bezier(0.23, 1, 0.32, 1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: radial-gradient(circle at 30% 10%, #1e293b, #0f172a 70%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Cairo', sans-serif;
      padding: 20px;
      direction: rtl;
    }
    .main-container {
      width: 100%;
      max-width: 850px;
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: var(--radius-lg);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      padding: 30px 25px 20px;
      color: var(--text);
      transition: var(--transition);
    }
    .header {
      text-align: center;
      margin-bottom: 25px;
    }
    .header h1 {
      font-size: 2.2rem;
      font-weight: 700;
      background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 5px;
    }
    .header .badge {
      display: inline-block;
      background: rgba(99, 102, 241, 0.15);
      padding: 4px 16px;
      border-radius: 20px;
      font-size: 0.8rem;
      color: #a5b4fc;
      border: 1px solid rgba(129, 140, 248, 0.3);
    }
    .expr-hint {
      font-size: 0.8rem;
      color: #a5b4fc;
      margin: 8px 0 5px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .input-field {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid rgba(148, 163, 184, 0.25);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      font-size: 1.15rem;
      color: white;
      outline: none;
      transition: var(--transition);
      font-family: 'Inter', 'Cairo', sans-serif;
    }
    .input-field:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.35);
    }
    .row {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin: 18px 0;
    }
    .unit-col {
      flex: 1 1 200px;
      position: relative;
    }
    .searchable-select {
      position: relative;
      width: 100%;
    }
    .search-input {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid rgba(148, 163, 184, 0.25);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      font-size: 0.95rem;
      color: white;
      outline: none;
      font-family: 'Cairo', sans-serif;
      transition: var(--transition);
    }
    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    }
    .options-list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #1e293b;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      max-height: 220px;
      overflow-y: auto;
      z-index: 20;
      display: none;
      backdrop-filter: blur(8px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.5);
      margin-top: 2px;
    }
    .options-list.active {
      display: block;
    }
    .option-item {
      padding: 10px 14px;
      cursor: pointer;
      font-size: 0.9rem;
      color: #cbd5e1;
      transition: background 0.15s;
      user-select: none;
    }
    .option-item:hover, .option-item.selected {
      background: rgba(99,102,241,0.35);
      color: white;
    }
    .swap-btn {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      border: none;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      cursor: pointer;
      color: white;
      box-shadow: 0 8px 20px rgba(99,102,241,0.4);
      transition: var(--transition);
      flex-shrink: 0;
    }
    .swap-btn:hover {
      transform: rotate(180deg) scale(1.05);
      box-shadow: 0 10px 25px rgba(139, 92, 246, 0.6);
    }
    .result-card {
      background: rgba(255,255,255,0.05);
      border-radius: var(--radius-lg);
      padding: 20px;
      margin: 20px 0;
      border: 1px solid rgba(129, 140, 248, 0.3);
      text-align: center;
      backdrop-filter: blur(5px);
    }
    .result-value {
      font-size: 3rem;
      font-weight: 700;
      color: #e0e7ff;
      word-break: break-word;
      font-family: 'Inter', 'Cairo', sans-serif;
    }
    .formula-box {
      margin-top: 12px;
      background: rgba(0,0,0,0.35);
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      font-family: 'Inter', monospace;
      font-size: 0.9rem;
      color: #a5b4fc;
      direction: ltr;
      display: inline-block;
    }
    .history-section {
      margin-top: 25px;
    }
    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 180px;
      overflow-y: auto;
    }
    .history-item {
      background: rgba(255,255,255,0.04);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid transparent;
      transition: var(--transition);
      cursor: pointer;
    }
    .history-item:hover {
      border-color: var(--accent);
      background: rgba(99,102,241,0.15);
    }
    .history-item span.reuse {
      color: var(--accent);
      font-weight: bold;
      margin-left: 10px;
      cursor: pointer;
    }
    .footer {
      text-align: center;
      margin-top: 25px;
      font-size: 0.8rem;
      color: #64748b;
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 15px;
      letter-spacing: 0.5px;
      font-weight: 500;
    }
    .data-system-toggle {
      display: flex;
      gap: 5px;
      background: rgba(0,0,0,0.3);
      border-radius: 20px;
      padding: 3px;
      margin: 5px 0 10px;
    }
    .toggle-btn {
      flex: 1;
      text-align: center;
      padding: 6px 12px;
      border-radius: 18px;
      font-size: 0.75rem;
      cursor: pointer;
      border: none;
      background: transparent;
      color: #94a3b8;
      transition: var(--transition);
    }
    .toggle-btn.active {
      background: var(--accent);
      color: white;
      font-weight: bold;
    }
    button {
      cursor: pointer;
      background: transparent;
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.8rem;
      transition: var(--transition);
    }
    button:hover {
      background: rgba(99,102,241,0.2);
    }
    .clear-btn {
      border-color: #f87171;
      color: #f87171;
    }
    .clear-btn:hover { background: rgba(248,113,113,0.2); }
    @media (max-width: 600px) {
      .row { flex-direction: column; }
      .swap-btn { align-self: center; }
    }
  </style>
</head>
<body>
<div class="main-container">
  <div class="header">
    <h1>🔄 محول الوحدات الذكي</h1>
    <div class="badge">أدقّ • أشمل • Taha-tech 2026</div>
  </div>

  <div class="expr-hint">
    <span>🧮 آلة حاسبة مدمجة:</span> اكتب تعبيراً مثل <code>(5*3.2)+2</code> أو <code>sqrt(9)</code>
  </div>
  <input type="text" id="inputValue" class="input-field" placeholder="أدخل القيمة أو تعبير حسابي..." value="100" autofocus>

  <div class="row">
    <div class="unit-col">
      <label style="display:block; margin-bottom:4px; font-size:0.8rem; color:#cbd5e1;">من وحدة</label>
      <div class="searchable-select" id="fromUnitContainer">
        <input type="text" class="search-input" id="fromSearch" placeholder="ابحث عن وحدة..." autocomplete="off">
        <div class="options-list" id="fromOptions"></div>
        <input type="hidden" id="fromUnit" value="meter">
      </div>
    </div>

    <button class="swap-btn" id="swapBtn" title="عكس الوحدات">⇄</button>

    <div class="unit-col">
      <label style="display:block; margin-bottom:4px; font-size:0.8rem; color:#cbd5e1;">إلى وحدة</label>
      <div class="searchable-select" id="toUnitContainer">
        <input type="text" class="search-input" id="toSearch" placeholder="ابحث عن وحدة..." autocomplete="off">
        <div class="options-list" id="toOptions"></div>
        <input type="hidden" id="toUnit" value="centimeter">
      </div>
    </div>
  </div>

  <!-- فئة الوحدات -->
  <div style="margin-bottom: 15px;">
    <label style="font-size:0.8rem; color:#cbd5e1;">فئة القياس:</label>
    <select id="categorySelect" style="width:100%; margin-top:5px; background:var(--input-bg); border:1px solid rgba(148,163,184,0.25); border-radius:12px; padding:12px; color:white; font-family:'Cairo';">
      <option value="length">📏 الطول</option>
      <option value="weight">⚖️ الوزن</option>
      <option value="temperature">🌡️ الحرارة</option>
      <option value="area">📐 المساحة</option>
      <option value="volume">🧴 الحجم</option>
      <option value="speed">💨 السرعة</option>
      <option value="time">⏱️ الزمن</option>
      <option value="pressure">🔴 الضغط</option>
      <option value="energy">⚡ الطاقة</option>
      <option value="data">💾 تخزين البيانات</option>
    </select>
    <!-- مفتاح النظام للبيانات فقط -->
    <div id="dataSystemToggle" class="data-system-toggle" style="display: none;">
      <button class="toggle-btn active" data-system="binary">ثنائي (1024)</button>
      <button class="toggle-btn" data-system="decimal">عشري (1000)</button>
    </div>
  </div>

  <div class="result-card">
    <div class="result-value" id="resultDisplay">1000</div>
    <div class="formula-box" id="formulaDisplay">1 م = 100 سم</div>
  </div>

  <div style="display:flex; gap:10px; justify-content: center;">
    <button id="addCustomUnitBtn">➕ وحدة مخصصة</button>
  </div>

  <div class="history-section">
    <div class="history-header">
      <h3 style="font-size:1rem;">📋 آخر التحويلات</h3>
      <button class="clear-btn" id="clearHistoryBtn">🗑️ مسح السجل</button>
    </div>
    <div class="history-list" id="historyContainer">
      <div style="color:#64748b; text-align:center;">لا توجد تحويلات بعد</div>
    </div>
  </div>

  <div class="footer">
    <span>© 2026 Taha-tech | جميع الحقوق محفوظة</span>
  </div>
</div>

<script>
  (function() {
    // ===================== بيانات الوحدات الموسّعة =====================
    const unitDatabase = {
      length: {
