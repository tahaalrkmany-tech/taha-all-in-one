        units: [
          { id: 'kg', name: 'كيلوغرام', toBase: 1 },
          { id: 'gram', name: 'غرام', toBase: 0.001 },
          { id: 'milligram', name: 'مليغرام', toBase: 1e-6 },
          { id: 'microgram', name: 'ميكروغرام', toBase: 1e-9 },
          { id: 'tonne', name: 'طن متري', toBase: 1000 },
          { id: 'us_ton', name: 'طن أمريكي', toBase: 907.18474 },
          { id: 'pound', name: 'رطل', toBase: 0.45359237 },
          { id: 'ounce', name: 'أونصة (عادية)', toBase: 0.028349523 },
          { id: 'troy_ounce', name: 'أونصة تروي', toBase: 0.0311034768 },
          { id: 'carat', name: 'قيراط', toBase: 0.0002 }
        ]
      },
      temperature: {
        name: 'الحرارة',
        units: [
          { id: 'celsius', name: 'مئوية (°C)', toBase: 'special' },
          { id: 'fahrenheit', name: 'فهرنهايت (°F)', toBase: 'special' },
          { id: 'kelvin', name: 'كلفن (K)', toBase: 'special' },
          { id: 'rankine', name: 'رانكين (°R)', toBase: 'special' },
          { id: 'reaumur', name: 'ريومور (°Ré)', toBase: 'special' }
        ]
      },
      area: {
        name: 'المساحة',
        baseUnit: 'متر مربع',
        units: [
          { id: 'sqmeter', name: 'متر مربع', toBase: 1 },
          { id: 'sqkilometer', name: 'كيلومتر مربع', toBase: 1e6 },
          { id: 'hectare', name: 'هكتار', toBase: 10000 },
          { id: 'feddan', name: 'فدان (مصري)', toBase: 4200.83 },
          { id: 'dunam', name: 'دونم', toBase: 1000 },
          { id: 'acre', name: 'آكر', toBase: 4046.8564224 },
          { id: 'sqmile', name: 'ميل مربع', toBase: 2.589988e6 },
          { id: 'sqfoot', name: 'قدم مربع', toBase: 0.09290304 },
          { id: 'sqyard', name: 'ياردة مربعة', toBase: 0.83612736 }
        ]
      },
      volume: {
        name: 'الحجم',
        baseUnit: 'لتر',
        units: [
          { id: 'liter', name: 'لتر', toBase: 1 },
          { id: 'milliliter', name: 'ملليلتر', toBase: 0.001 },
          { id: 'cubicmeter', name: 'متر مكعب', toBase: 1000 },
          { id: 'cubiccm', name: 'سم³', toBase: 0.001 },
          { id: 'us_gallon', name: 'غالون أمريكي', toBase: 3.785411784 },
          { id: 'uk_gallon', name: 'غالون إمبراطوري', toBase: 4.54609 },
          { id: 'oil_barrel', name: 'برميل نفط', toBase: 158.9873 },
          { id: 'us_pint', name: 'باينت أمريكي', toBase: 0.473176473 },
          { id: 'us_quart', name: 'كوارت أمريكي', toBase: 0.946352946 }
        ]
      },
      speed: {
        name: 'السرعة',
        baseUnit: 'متر/ثانية',
        units: [
          { id: 'mps', name: 'متر/ثانية', toBase: 1 },
          { id: 'kmph', name: 'كم/ساعة', toBase: 0.277777778 },
          { id: 'mph', name: 'ميل/ساعة', toBase: 0.44704 },
          { id: 'knot', name: 'عقدة', toBase: 0.514444444 },
          { id: 'ftps', name: 'قدم/ثانية', toBase: 0.3048 },
          { id: 'speed_of_light', name: 'سرعة الضوء (ج)', toBase: 299792458 }
        ]
      },
      time: {
        name: 'الزمن',
        baseUnit: 'ثانية',
        units: [
          { id: 'second', name: 'ثانية', toBase: 1 },
          { id: 'millisecond', name: 'ميلي ثانية', toBase: 0.001 },
          { id: 'microsecond', name: 'ميكروثانية', toBase: 1e-6 },
          { id: 'nanosecond', name: 'نانو ثانية', toBase: 1e-9 },
          { id: 'minute', name: 'دقيقة', toBase: 60 },
          { id: 'hour', name: 'ساعة', toBase: 3600 },
          { id: 'day', name: 'يوم', toBase: 86400 },
          { id: 'week', name: 'أسبوع', toBase: 604800 },
          { id: 'month', name: 'شهر (متوسط)', toBase: 2629746 },
          { id: 'year', name: 'سنة (365.25 يوم)', toBase: 31557600 }
        ]
      },
      pressure: {
        name: 'الضغط',
        baseUnit: 'باسكال',
        units: [
          { id: 'pascal', name: 'باسكال', toBase: 1 },
          { id: 'kpa', name: 'كيلوباسكال', toBase: 1000 },
          { id: 'bar', name: 'بار', toBase: 100000 },
          { id: 'atm', name: 'ضغط جوي (atm)', toBase: 101325 },
          { id: 'psi', name: 'PSI (رطل/بوصة²)', toBase: 6894.75729 },
          { id: 'mmhg', name: 'مم زئبق', toBase: 133.322 }
        ]
      },
      energy: {
        name: 'الطاقة',
        baseUnit: 'جول',
        units: [
          { id: 'joule', name: 'جول', toBase: 1 },
          { id: 'kj', name: 'كيلوجول', toBase: 1000 },
          { id: 'calorie', name: 'سعر حراري', toBase: 4.184 },
          { id: 'kcal', name: 'كيلو سعر', toBase: 4184 },
          { id: 'wh', name: 'واط ساعة', toBase: 3600 },
          { id: 'kwh', name: 'كيلوواط ساعة', toBase: 3600000 },
          { id: 'btu', name: 'BTU', toBase: 1055.06 },
          { id: 'ev', name: 'إلكترون فولت', toBase: 1.602176634e-19 }
        ]
      },
      data: {
        name: 'تخزين البيانات',
        unitsBinary: [
          { id: 'bit', name: 'بت', toBase: 1/8 },
          { id: 'byte', name: 'بايت', toBase: 1 },
          { id: 'kib', name: 'كيبيبايت (KiB)', toBase: 1024 },
          { id: 'mib', name: 'ميبيبايت (MiB)', toBase: 1048576 },
          { id: 'gib', name: 'غيبيبايت (GiB)', toBase: 1073741824 },
          { id: 'tib', name: 'تيبيبايت (TiB)', toBase: 1099511627776 }
        ],
        unitsDecimal: [
          { id: 'bit_dec', name: 'بت', toBase: 1/8 },
          { id: 'byte_dec', name: 'بايت', toBase: 1 },
          { id: 'kb', name: 'كيلوبايت (KB)', toBase: 1000 },
          { id: 'mb', name: 'ميغابايت (MB)', toBase: 1e6 },
          { id: 'gb', name: 'غيغابايت (GB)', toBase: 1e9 },
          { id: 'tb', name: 'تيرابايت (TB)', toBase: 1e12 }
        ]
      }
    };

    // حالة التطبيق
    let currentCategory = 'length';
    let currentDataSystem = 'binary';
    let history = JSON.parse(localStorage.getItem('tahaConverterHistory') || '[]');

    // عناصر DOM
    const inputValue = document.getElementById('inputValue');
    const categorySelect = document.getElementById('categorySelect');
    const fromSearch = document.getElementById('fromSearch');
    const toSearch = document.getElementById('toSearch');
    const fromOptions = document.getElementById('fromOptions');
    const toOptions = document.getElementById('toOptions');
    const fromUnitHidden = document.getElementById('fromUnit');
    const toUnitHidden = document.getElementById('toUnit');
    const resultDisplay = document.getElementById('resultDisplay');
    const formulaDisplay = document.getElementById('formulaDisplay');
    const swapBtn = document.getElementById('swapBtn');
    const historyContainer = document.getElementById('historyContainer');
    const clearHistoryBtn = document.getElementById('clearHistoryBtn');
    const addCustomUnitBtn = document.getElementById('addCustomUnitBtn');
    const dataToggleDiv = document.getElementById('dataSystemToggle');

    // الحصول على قائمة الوحدات الحالية
    function getCurrentUnits() {
      if (currentCategory === 'data') {
        return currentDataSystem === 'binary' ? unitDatabase.data.unitsBinary : unitDatabase.data.unitsDecimal;
      }
      return unitDatabase[currentCategory].units;
    }

    // تحديث عرض القوائم والخيارات
    function renderOptions(optionsListElement, hiddenInput, searchInput) {
      const units = getCurrentUnits();
      const searchTerm = searchInput.value.trim().toLowerCase();
      const filtered = units.filter(u => u.name.toLowerCase().includes(searchTerm));
      const selectedId = hiddenInput.value;
      
      optionsListElement.innerHTML = '';
      if (filtered.length === 0) {
        optionsListElement.innerHTML = '<div class="option-item" style="color:#64748b;">لا توجد نتائج</div>';
      } else {
        filtered.forEach(u => {
          const div = document.createElement('div');
          div.className = 'option-item';
          div.textContent = u.name;
          div.dataset.id = u.id;
          if (u.id === selectedId) div.classList.add('selected');
          
          // استخدام mousedown بدلاً من click لمنع مشكلة فقدان التركيز
          div.addEventListener('mousedown', function(e) {
            e.preventDefault(); // منع فقدان التركيز من حقل البحث
            hiddenInput.value = u.id;
            searchInput.value = u.name;
            optionsListElement.classList.remove('active');
            convertAndDisplay();
          });
          
          optionsListElement.appendChild(div);
        });
      }
    }

    // تحديث عرض الحقول بناءً على القيم المخفية
    function updateSelectDisplays() {
      const units = getCurrentUnits();
      const fromId = fromUnitHidden.value;
      const toId = toUnitHidden.value;
      const fromUnit = units.find(u => u.id === fromId);
      const toUnit = units.find(u => u.id === toId);
      if (fromUnit) fromSearch.value = fromUnit.name;
      if (toUnit) toSearch.value = toUnit.name;
      // تحديث القوائم المخفية عند الضرورة
      renderOptions(fromOptions, fromUnitHidden, fromSearch);
      renderOptions(toOptions, toUnitHidden, toSearch);
    }

    // دوال التحويل
    function safeEval(expr) {
      if (!expr) return NaN;
      const sanitized = expr.replace(/\s/g, '');
      try {
        const result = Function('"use strict"; return (' + sanitized
          .replace(/sqrt\(/g, 'Math.sqrt(')
          .replace(/sin\(/g, 'Math.sin(')
          .replace(/cos\(/g, 'Math.cos(')
          .replace(/tan\(/g, 'Math.tan(')
          .replace(/log\(/g, 'Math.log10(')
          .replace(/ln\(/g, 'Math.log(')
          .replace(/abs\(/g, 'Math.abs(')
          .replace(/PI/g, 'Math.PI')
          .replace(/E/g, 'Math.E')
          + ')')();
        return isNaN(result) || !isFinite(result) ? NaN : result;
      } catch (e) {
        return NaN;
      }
    }

    function convertTemperature(value, from, to) {
      let celsius;
      switch (from) {
        case 'celsius': celsius = value; break;
        case 'fahrenheit': celsius = (value - 32) * 5/9; break;
        case 'kelvin': celsius = value - 273.15; break;
        case 'rankine': celsius = (value - 491.67) * 5/9; break;
        case 'reaumur': celsius = value * 1.25; break;
        default: return NaN;
      }
      switch (to) {
        case 'celsius': return celsius;
        case 'fahrenheit': return (celsius * 9/5) + 32;
        case 'kelvin': return celsius + 273.15;
        case 'rankine': return (celsius + 273.15) * 9/5;
        case 'reaumur': return celsius * 0.8;
        default: return NaN;
      }
    }

    function getTemperatureFormula(from, to) {
      const map = {
        'celsius_fahrenheit': '°F = (°C × 9/5) + 32',
        'fahrenheit_celsius': '°C = (°F - 32) × 5/9',
        'celsius_kelvin': 'K = °C + 273.15',
        'kelvin_celsius': '°C = K - 273.15',
        'fahrenheit_kelvin': 'K = (°F - 32) × 5/9 + 273.15',
        'kelvin_fahrenheit': '°F = (K - 273.15) × 9/5 + 32',
        'celsius_rankine': '°R = (°C + 273.15) × 9/5',
        'rankine_celsius': '°C = (°R - 491.67) × 5/9',
        'fahrenheit_rankine': '°R = °F + 459.67',
        'rankine_fahrenheit': '°F = °R - 459.67',
        'celsius_reaumur': '°Ré = °C × 0.8',
        'reaumur_celsius': '°C = °Ré × 1.25',
        'kelvin_rankine': '°R = K × 9/5',
        'rankine_kelvin': 'K = °R × 5/9',
      };
      return map[`${from}_${to}`] || 'صيغة حرارية خاصة';
    }

    function convertAndDisplay() {
      const expr = inputValue.value.trim();
      if (!expr) {
        resultDisplay.textContent = '—';
        formulaDisplay.textContent = 'أدخل قيمة';
        return;
      }
      const numericValue = safeEval(expr);
      if (isNaN(numericValue)) {
        resultDisplay.textContent = 'خطأ في الإدخال';
        formulaDisplay.textContent = 'تأكد من الرقم أو التعبير';
        return;
      }

      const units = getCurrentUnits();
      const fromId = fromUnitHidden.value;
      const toId = toUnitHidden.value;
      const fromUnit = units.find(u => u.id === fromId);
      const toUnit = units.find(u => u.id === toId);
      if (!fromUnit || !toUnit) {
        resultDisplay.textContent = 'اختر الوحدات';
        return;
      }

      let result, formulaText = '';
      if (currentCategory === 'temperature') {
        result = convertTemperature(numericValue, fromId, toId);
        formulaText = getTemperatureFormula(fromId, toId) + ` = ${result?.toFixed(4)}`;
      } else {
        const baseValue = numericValue * fromUnit.toBase;
        result = baseValue / toUnit.toBase;
        const factor = (fromUnit.toBase / toUnit.toBase);
        formulaText = `1 ${fromUnit.name} = ${factor.toPrecision(6)} ${toUnit.name}`;
      }

      if (isNaN(result)) {
        resultDisplay.textContent = 'خطأ في التحويل';
        formulaDisplay.textContent = '';
      } else {
        resultDisplay.textContent = result.toFixed(8).replace(/\.?0+$/, '');
        formulaDisplay.textContent = formulaText;

        const entry = {
          expr: expr,
          value: numericValue,
          from: fromUnit.name,
          to: toUnit.name,
          result: resultDisplay.textContent,
          formula: formulaText,
          time: new Date().toLocaleTimeString('ar-SA')
        };
        history.unshift(entry);
        if (history.length > 10) history.pop();
        localStorage.setItem('tahaConverterHistory', JSON.stringify(history));
        renderHistory();
      }
    }

    function renderHistory() {
      if (history.length === 0) {
        historyContainer.innerHTML = '<div style="color:#64748b; text-align:center;">لا توجد تحويلات بعد</div>';
        return;
      }
      historyContainer.innerHTML = history.map((h, i) => `
        <div class="history-item" data-index="${i}">
          <div>
            <strong>${h.value} ${h.from}</strong> → <strong>${h.result} ${h.to}</strong>
            <div style="font-size:0.7rem; color:#94a3b8;">${h.formula}</div>
          </div>
          <span class="reuse" data-reuse="${i}">🔄</span>
        </div>
      `).join('');

      document.querySelectorAll('.history-item .reuse').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(el.dataset.reuse);
          const h = history[idx];
          inputValue.value = h.value;
          for (let cat in unitDatabase) {
            const units = (cat === 'data' ? (currentDataSystem === 'binary' ? unitDatabase.data.unitsBinary : unitDatabase.data.unitsDecimal) : unitDatabase[cat].units);
            const foundFrom = units.find(u => u.name === h.from);
            if (foundFrom) {
              categorySelect.value = cat;
              currentCategory = cat;
              if (cat === 'data') {
                dataToggleDiv.style.display = 'flex';
              } else {
                dataToggleDiv.style.display = 'none';
              }
              fromUnitHidden.value = foundFrom.id;
              const foundTo = units.find(u => u.name === h.to);
              if (foundTo) toUnitHidden.value = foundTo.id;
              updateSelectDisplays();
              convertAndDisplay();
              break;
            }
          }
        });
      });
    }

    function clearHistory() {
      history = [];
      localStorage.removeItem('tahaConverterHistory');
      renderHistory();
    }

    function addCustomUnit() {
      const name = prompt('اسم الوحدة الجديدة:');
      if (!name) return;
      const factor = parseFloat(prompt('معامل التحويل إلى الوحدة الأساسية (مثلاً: إذا 1 وحدتك = 2.5 من الأساسي، أدخل 2.5):'));
      if (isNaN(factor) || factor <= 0) return alert('معامل غير صالح');
      const id = 'custom_' + Date.now();
      if (currentCategory === 'data') {
        const unitsArray = currentDataSystem === 'binary' ? unitDatabase.data.unitsBinary : unitDatabase.data.unitsDecimal;
        unitsArray.push({ id, name, toBase: factor });
      } else {
        unitDatabase[currentCategory].units.push({ id, name, toBase: factor });
      }
      toUnitHidden.value = id;
      updateSelectDisplays();
      convertAndDisplay();
    }

    function swapUnits() {
      const tempId = fromUnitHidden.value;
      fromUnitHidden.value = toUnitHidden.value;
      toUnitHidden.value = tempId;
      updateSelectDisplays();
      convertAndDisplay();
    }

    // إعداد القوائم المنسدلة القابلة للبحث مع إصلاح مشكلة الاختيار
    function setupSearchable(optionsList, hiddenInput, searchInput) {
      // عند التركيز على حقل البحث نظهر القائمة
      searchInput.addEventListener('focus', () => {
        renderOptions(optionsList, hiddenInput, searchInput);
        optionsList.classList.add('active');
      });

      // عند الكتابة نحدث النتائج
      searchInput.addEventListener('input', () => {
        renderOptions(optionsList, hiddenInput, searchInput);
        optionsList.classList.add('active');
      });

      // إخفاء القائمة عند فقدان التركيز، ولكن بعد تأخير بسيط للسماح بالنقر
      searchInput.addEventListener('blur', () => {
        setTimeout(() => {
          // نتأكد أن العنصر النشط ليس من عناصر القائمة
          if (!optionsList.contains(document.activeElement)) {
            optionsList.classList.remove('active');
          }
        }, 150);
      });

      // دعم اختيار الوحدة بلوحة المفاتيح (Enter)
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const first = optionsList.querySelector('.option-item');
          if (first) {
            first.click();
          }
        } else if (e.key === 'Escape') {
          optionsList.classList.remove('active');
        }
      });

      // إغلاق القائمة عند النقر خارج المكون
      document.addEventListener('click', (e) => {
        if (!searchInput.parentElement.contains(e.target)) {
          optionsList.classList.remove('active');
        }
      });
    }

    function changeCategory() {
      currentCategory = categorySelect.value;
      if (currentCategory === 'data') {
        dataToggleDiv.style.display = 'flex';
      } else {
        dataToggleDiv.style.display = 'none';
      }
      const units = getCurrentUnits();
      if (units.length > 0) {
        fromUnitHidden.value = units[0].id;
        toUnitHidden.value = units.length > 1 ? units[1].id : units[0].id;
      }
      updateSelectDisplays();
      convertAndDisplay();
    }

    function setDataSystem(system) {
      currentDataSystem = system;
      document.querySelectorAll('#dataSystemToggle .toggle-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.system === system);
      });
      const units = getCurrentUnits();
      if (units.length > 0) {
        fromUnitHidden.value = units[0].id;
        toUnitHidden.value = units.length > 1 ? units[1].id : units[0].id;
      }
      updateSelectDisplays();
      convertAndDisplay();
    }

    // ربط الأحداث
    inputValue.addEventListener('input', convertAndDisplay);
    categorySelect.addEventListener('change', changeCategory);
    swapBtn.addEventListener('click', swapUnits);
    clearHistoryBtn.addEventListener('click', clearHistory);
    addCustomUnitBtn.addEventListener('click', addCustomUnit);
    document.querySelectorAll('#dataSystemToggle .toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => setDataSystem(btn.dataset.system));
    });

    // إعداد القوائم المنسدلة
    setupSearchable(fromOptions, fromUnitHidden, fromSearch);
    setupSearchable(toOptions, toUnitHidden, toSearch);

    // بدء التشغيل
    changeCategory();
    renderHistory();
  })();
</script>
</body>
</html>
